rules_version = '2';

// Strayfriends Firestore security rules.
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // === Helpers ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // True when the signed-in user's profile doc has role admin or ngo.
    // Admin = UTM staff coordinating welfare; NGO = registered partner
    // (e.g. PAWS Johor). Both have privileged write access to campaigns,
    // reports, and allocations. Regular 'user' role is the default.
    function isAdminOrNgo() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userRole() in ['admin', 'ngo'];
    }

    // === users/{uid} ===
    // Profile doc per user. uid IS the doc id.
    // - Read: any signed-in user (so report cards can show reporter name)
    // - Create: only the user themselves, on registration; role locked to 'user'
    // - Update: only the user themselves; role cannot be changed by self
    //   (admin/ngo seeded manually by lead dev via Firestore console)
    // - Delete: disallowed from client
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
                    && request.resource.data.role == 'user';
      allow update: if isSelf(uid)
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // === reports/{id} ===
    // Cat sighting reports. NAD-9.
    // - Read: anyone (public Feed includes unauthed visitors per UC-06)
    // - Create: any signed-in user, must set their own uid as userId
    // - Update: only admin/ngo (e.g. status changes)
    // - Delete: only admin/ngo
    match /reports/{id} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Admin/NGO may update anything (incl. status). OR the OWNER may edit
      // their OWN report's content while it is still pending — but never the
      // status, owner, or creation time (strict lock).
      allow update: if isAdminOrNgo()
                    || (
                      isSignedIn()
                      && resource.data.userId == request.auth.uid
                      && resource.data.status == 'pending'
                      && request.resource.data.status == 'pending'
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.createdAt == resource.data.createdAt
                    );
      allow delete: if isAdminOrNgo();
    }

    // === campaigns/{id} ===  NAD-22, NAD-25
    // Fundraising campaigns. Schema: title, description, goalAmount,
    // currentAmount, imageUrl, status, createdBy, createdAt, endsAt.
    // - Read: public — anyone can browse active campaigns
    // - Create: admin/ngo only; must set createdBy to own uid;
    //           currentAmount must start at 0; status must be 'active'
    // - Update: admin/ngo only (status flips, edits to description, etc.)
    //   Note: currentAmount also gets incremented by Cloud Function via
    //   service account — service account bypasses rules.
    // - Delete: disallowed from client (use status='archived' instead)
    match /campaigns/{id} {
      allow read: if true;
      allow create: if isAdminOrNgo()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.currentAmount == 0
                    && request.resource.data.status == 'active';
      allow update: if isAdminOrNgo();
      allow delete: if false;
    }

    // === donations/{id} ===  NAD-21, NAD-26
    // Donor payment records. Schema: donorId, campaignId, amount,
    // transactionId, stripeSessionId, status ('success'), donorName,
    // createdAt.
    // - Read: donor reads own; admin/ngo reads all (transparency)
    // - Create: DISALLOWED from client. Donations are written ONLY by
    //           the `stripeWebhook` Cloud Function (admin service account,
    //           bypasses rules) after Stripe confirms a real payment.
    //           This makes a fabricated donation impossible from the app.
    // - Update / Delete: disallowed.
    match /donations/{id} {
      allow read: if isSignedIn() && (
                    resource.data.donorId == request.auth.uid ||
                    isAdminOrNgo()
                  );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // === allocations/{id} ===  NAD-22, NAD-27
    // Spend records per campaign. Schema: campaignId, amount, purpose,
    // createdBy, createdAt, evidenceUrl?.
    // - Read: public — transparency requirement
    // - Create: admin/ngo only; createdBy must be own uid; amount > 0;
    //           campaignId must reference an existing campaign.
    //           The invariant sum(allocations) <= campaign.currentAmount
    //           is enforced by the AllocationsService transaction
    //           (rules cannot sum across docs).
    // - Update: admin/ngo only (e.g. attach receipt evidenceUrl)
    // - Delete: disallowed
    match /allocations/{id} {
      allow read: if true;
      allow create: if isAdminOrNgo()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId));
      allow update: if isAdminOrNgo();
      allow delete: if false;
    }

    // === activities/{id} ===  NAD-42 (Sprint 3)
    // Volunteer activities. Schema: title, description, location,
    // dateTime, slots, slotsRemaining, imageUrl?, createdBy, status,
    // createdAt.
    // - Read: public — anyone can browse upcoming activities (UC-16)
    // - Create: admin/ngo only; createdBy must equal own uid;
    //           slotsRemaining must start equal to slots; status upcoming
    // - Update: admin/ngo (any field) OR any signed-in user changing
    //           ONLY slotsRemaining (the sign-up / cancel transaction in
    //           SignupsService decrements/restores it atomically)
    // - Delete: disallowed from client (use status='cancelled')
    match /activities/{id} {
      allow read: if true;
      allow create: if isAdminOrNgo()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.slots is number
                    && request.resource.data.slotsRemaining == request.resource.data.slots
                    && request.resource.data.status == 'upcoming';
      allow update: if isAdminOrNgo()
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['slotsRemaining'])
                        // Only ±1: a sign-up decrements, a cancel
                        // increments. Blocks a crafted client from
                        // setting an arbitrary slot count (grief).
                        && (request.resource.data.slotsRemaining ==
                                resource.data.slotsRemaining - 1
                            || request.resource.data.slotsRemaining ==
                                resource.data.slotsRemaining + 1));
      allow delete: if false;
    }

    // === signups/{id} ===  NAD-43 (Sprint 3)
    // Volunteer ↔ activity join. Doc id is {activityId}_{volunteerId}
    // (deterministic — prevents duplicates). Schema: volunteerId,
    // activityId, signedAt, volunteerName?.
    // - Read: the volunteer reads own; admin/ngo reads all (to see the
    //         volunteer roster for an activity — UC-19)
    // - Create: signed-in user, volunteerId must equal own uid, the
    //           referenced activity must exist. The slot decrement is done
    //           in the same client transaction (see SignupsService).
    // - Update: disallowed.
    // - Delete: the volunteer may cancel their own sign-up.
    match /signups/{id} {
      // `resource == null` lets a signed-in user read a NON-existent signup
      // doc — required by the sign-up transaction + watchIsSignedUp stream,
      // which check existence by deterministic id ({activityId}_{uid}). Without
      // it, get() on a missing doc evaluates resource.data on null → denied,
      // so sign-up failed with "Something went wrong". Existing signups stay
      // restricted to the owner / admin / ngo.
      allow read: if isSignedIn() && (
                    resource == null ||
                    resource.data.volunteerId == request.auth.uid ||
                    isAdminOrNgo()
                  );
      allow create: if isSignedIn()
                    && request.resource.data.volunteerId == request.auth.uid
                    && exists(/databases/$(database)/documents/activities/$(request.resource.data.activityId));
      allow update: if false;
      allow delete: if isSignedIn()
                    && resource.data.volunteerId == request.auth.uid;
    }

    // === Default deny ===
    // Any collection not explicitly matched above is fully locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
