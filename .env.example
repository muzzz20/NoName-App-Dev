# Copy this file to .env and fill in real values. .env is gitignored.
# Firebase config is auto-generated by `flutterfire configure` into lib/firebase_options.dart
# so most secrets live there. This file is for runtime-loaded keys only.

# Payment gateway sandbox (Sprint 2 — Stripe / Billplz)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=

# Optional analytics
SENTRY_DSN=
