# Optional runtime keys. The app runs WITHOUT this file — Firebase config
# (Auth/Firestore/Storage) is compiled into lib/firebase_options.dart by
# `flutterfire configure`. Storage is Firebase Cloud Storage (migrated off
# Supabase once the project moved to the Blaze plan).
#
# This file is ONLY needed in Sprint 4 when real payment gateway keys are
# wired. Until then PaymentService runs in simulation mode and ignores these.
# To use: copy to .env, fill values, and re-add `.env` under flutter.assets
# in pubspec.yaml.

# Payment gateway sandbox (Sprint 4 — Stripe / Billplz / ToyyibPay)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=

# Optional analytics
SENTRY_DSN=
