# Copy this file to .env and fill in real values. .env is gitignored.
# Firebase config is auto-generated by `flutterfire configure` into lib/firebase_options.dart
# so most Firebase secrets live there. This file is for runtime-loaded keys only.

# Supabase (object storage for cat photos — NAD-10)
# Get from https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Payment gateway sandbox (Sprint 2 — Stripe / Billplz)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=

# Optional analytics
SENTRY_DSN=
